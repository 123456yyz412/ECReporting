DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=ecreporting
APP_DB_USER=ecreporting
APP_DB_PASSWORD=ecreporting

CORS_ALLOW_ALL_ORIGINS=1
CORS_ALLOWED_ORIGINS=

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

FERNET_KEYS=

LOG_DIR=/var/log/ecreporting
LOG_LEVEL=INFO

MEDIA_ROOT=/var/lib/ecreporting/media
STATIC_ROOT=/var/lib/ecreporting/staticfiles
